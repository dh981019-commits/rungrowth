{
  "expo": {
    "name": "Runner's Hi",
    "slug": "runners-hi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "runnershi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f766e"
      }
    }
  }
}
